# Database (SQLite for local dev; swap to PostgreSQL in production)
DATABASE_URL="file:./dev.db"

# Session signing secret — generate with: openssl rand -base64 48
AUTH_SECRET="dev-only-secret-change-me-in-production-0000000000000"

# Public app URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Payment provider keys (mock adapters are used when unset)
PAYMENT_PROVIDER_DE="mock"   # stripe | mock
PAYMENT_PROVIDER_LB="mock"   # areeba | whish | mock
